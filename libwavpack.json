{
    "name": "libwavpack",
    "description": "WavPack decoder",
    "filters":["wvdec"],
    "help": "This filter decodes WavPack (.wv) audio using libwavpack.",
    "support": [
        "audio"
    ],
    "sources":"https://bevara.ddns.net/sources/libwavpack.accessor",
    "filter_source":{
        "wvdec" : "dec_wavpack.c"
    },
    "extension":{
      "wv" : "audio"
    },
    "licence_required":false,
    "using": ["solver_minimal_1", "solver_1"]
}
